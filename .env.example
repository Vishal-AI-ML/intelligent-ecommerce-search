# Copy to .env for local use. Never commit .env. Placeholders only.
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_search
POSTGRES_USER=ecommerce_search
# Required: choose a non-empty local-only password (Compose refuses to start without one).
POSTGRES_PASSWORD=

# Conservative local-development defaults; not benchmarked and not production SLOs.
DB_CONNECT_TIMEOUT_SECONDS=3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# Lexical search (Milestone 3). Forwarded to the api container by Compose with these defaults.
SEARCH_LEXICAL_K=50
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_QUERY_LENGTH=200

# Dense search (Milestone 4). SEARCH_DENSE_K is forwarded to the api container by Compose.
SEARCH_DENSE_K=50
# The embedding model is pinned in code (ADR-006); only reviewed registry entries are accepted.
# Host default for model snapshots: the git-ignored models/ directory at the repository root.
# The api container always uses its read-only mount (/models). Uncomment only to override.
# EMBEDDING_MODELS_DIR=
EMBEDDING_BATCH_SIZE=32
